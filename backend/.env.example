# ==============================================================
# PROTECTFARM Backend Environment Configuration (MongoDB / Render / Netlify)
# ==============================================================

ENVIRONMENT=development
PROJECT_NAME="PROTECTFARM Real-Time Intelligence API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.netlify.app"]

# Database (MongoDB / MongoDB Atlas)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=protectfarm

# Authentication (Clerk)
CLERK_SECRET_KEY=mock_dev_key
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Weather Intelligence APIs (Open-Meteo works without keys; OpenWeatherMap optional)
OPENWEATHER_API_KEY=

# Explainable AI (Google Gemini - optional agronomy fallback active)
GEMINI_API_KEY=

# Email Alert Dispatcher (SMTP / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="PROTECTFARM Alerts <alerts@protectfarm.org>"
