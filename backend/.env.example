# ==============================================================
# PROTECTFARM Backend Environment Configuration (Render / Local)
# ==============================================================

# Application
ENVIRONMENT=development
PROJECT_NAME="PROTECTFARM Real-Time Intelligence API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.netlify.app"]

# Database (MySQL 8.0 / Render MySQL)
# Format for MySQL: mysql+asyncmy://user:password@host:port/database_name
# Fallback to local SQLite if MySQL is not available: sqlite+aiosqlite:///./protectfarm.db
DATABASE_URL=sqlite+aiosqlite:///./protectfarm.db
# DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/protectfarm

# Authentication (Clerk)
CLERK_SECRET_KEY=mock_or_real_clerk_secret_key
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Weather Intelligence APIs (OpenWeatherMap / IMD)
OPENWEATHER_API_KEY=mock_or_real_openweather_key

# Explainable AI (Google Gemini or OpenAI)
GEMINI_API_KEY=mock_or_real_gemini_key

# Email Alert Dispatcher (Resend or SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts.protectfarm@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="PROTECTFARM Alerts <alerts@protectfarm.org>"
